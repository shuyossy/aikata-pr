# AI
AI_API_KEY=your-api-key
AI_API_ENDPOINT_URL=https://api.example.com/v1
AI_MODEL_NAME=
OPENAI_REASONING_EFFORT=

# GitLab
GITLAB_API_URL=
AIKATA_PR_GITLAB_TOKEN=your-gitlab-token
GITLAB_PROJECT_ID=
GITLAB_MR_IID=

# Input
CHECKLIST_PATH=
CHECKLIST_COLUMNS=
CHECKLIST_NO_HEADER=false
REVIEW_SETTINGS_PATH=
SKILLS_PATH=

# Feature Toggle
AIKATA_PR_DISABLED=false

# Settings
USER_ID=
AIKATA_LOG_LEVEL=info
PRETTY_PRINT=true
COMMENT_LANGUAGE=Japanese

# Tree
TREE_MAX_DEPTH=

# Context Length
MAX_CONTEXT_LENGTH=

# API Mode (AI_API_KEY, AI_API_ENDPOINT_URL, AI_MODEL_NAMEが全て未設定時に必要)
AIKATA_API_URL=

# --- pipeline-report feature ---
# PIPELINE_REPORT_SETTINGS_PATH=
# PIPELINE_REPORT_RESULT_FILE=./aikata-pipeline-report.md
# PIPELINE_REPORT_MAX_ARTIFACT_ZIP_MB=50
# PIPELINE_REPORT_TOTAL_ARTIFACT_DISK_MB=500
# PIPELINE_REPORT_MAX_ARTIFACT_FILE_BYTES=2097152
# PIPELINE_REPORT_MAX_COMPLETENESS_RETRIES=3
# PIPELINE_REPORT_SKIP_COMPLETENESS_CHECK=false
# GITLAB_PIPELINE_ID=
# GITLAB_SELF_JOB_ID=

# Environment (CI環境では自動設定)
CI_PROJECT_DIR=

# === Debug Configuration ===
# VSCodeデバッグ用の環境変数ファイル:
#   .env                            - review CLI ローカルモード用（AI_*設定）
#   .env.debug.api                  - review CLI APIモード用（AI_*未設定、AIKATA_API_URL/AIKATA_JWT設定）
#   .env.debug.server               - APIサーバー用（AI_*設定、JWT_*未設定で認証無効）
#   .env.debug.pipeline-report      - pipeline-report CLI ローカルモード用（AI_*設定、GITLAB_PIPELINE_ID設定）
#   .env.debug.pipeline-report.api  - pipeline-report CLI APIモード用（AI_*未設定、AIKATA_API_URL/AIKATA_JWT設定）
# 詳細は .vscode/launch.json を参照

# === API Server Configuration (for docker/prod deployment) ===
# JWT_JWKS_URL=https://gitlab.example.com/oauth/discovery/keys
# JWT_AUDIENCE=https://aikata-api.example.com
# JWT_ISSUER=https://gitlab.example.com
# AI_API_RATE_LIMIT_PER_MIN=60
# MAX_CONCURRENT_CLONES=5
# CLONE_TIMEOUT_MS=300000
# REVIEW_TIMEOUT_MS=3600000
# CLONE_MAX_DISK_MB=1024
# API_PORT=3000
# MAX_CONTEXT_LENGTH=
