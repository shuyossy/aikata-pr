+# .ci-template/pipelines/pipeline-report/template-npx.yml
+# 提供先プロジェクトで include して利用するCIテンプレート（npx方式、pipeline-report機能）
+#
+# 使い方:
+#   include:
+#     - project: '<本プロジェクトのパス>'
+#       file: '.ci-template/pipelines/pipeline-report/template-npx.yml'
+
+include:
+  - local: '.ci-template/variable/variables.yml'
+
+stages:
+  - .post
+
+aikata-pipeline-report:
+  stage: .post
+  image: node:22-slim
+  variables:
+    NPM_CONFIG_CACHE: "$CI_PROJECT_DIR/.npm"
+  cache:
+    key: "aikata-pr-v${AIKATA_VERSION}"
+    paths:
+      - .npm/
+  # JWT生成: APIモード時（AI_API_KEY, AI_API_ENDPOINT_URL, AI_MODEL_NAMEが全て未設定の場合）にGitLabがJWTを発行する
+  # ローカル実行モード（上記3変数が全て設定されている場合）ではJWTは使用されない
+  id_tokens:
+    AIKATA_JWT:
+      aud: "${AIKATA_API_URL}"
+  # 全パイプラインの最終段階で実行（成功・失敗問わず）。AIKATA_PR_DISABLED=trueの場合はスキップ
+  rules:
+    - if: $AIKATA_PR_DISABLED == "true"
+      when: never
+    - when: always
+  script:
+    # AIKATA_PR_GITLAB_TOKENが設定されているかチェック
+    - |
+      if [ -z "$AIKATA_PR_GITLAB_TOKEN" ]; then
+        echo "Error: AIKATA_PR_GITLAB_TOKEN is not set. Please configure AIKATA_PR_GITLAB_TOKEN." >&2
+        exit 1
+      fi
+    # GitLab npm Registryの認証設定
+    - echo "@aikata:registry=https://${CI_SERVER_HOST}/api/v4/projects/${AIKATA_PROJECT_ID}/packages/npm/" > .npmrc
+    - echo "//${CI_SERVER_HOST}/api/v4/projects/${AIKATA_PROJECT_ID}/packages/npm/:_authToken=${AIKATA_PR_GITLAB_TOKEN}" >> .npmrc
+    # npx経由でaikata-prを実行（pipeline-reportサブコマンド、キャッシュによりバージョンが同じ場合は高速）
+    - |
+      npx @aikata/aikata-pr@${AIKATA_VERSION} pipeline-report \
+        --user-id "${USER_ID}" \
+        --project-id "${GITLAB_PROJECT_ID}" \
+        --pipeline-id "${GITLAB_PIPELINE_ID}" \
+        --self-job-id "${GITLAB_SELF_JOB_ID}" \
+        --log-level "${AIKATA_LOG_LEVEL}"
+  artifacts:
+    when: always
+    paths:
+      - ${PIPELINE_REPORT_RESULT_FILE}
+    expire_in: 1 week
