+    linesAbove: overrides?.linesAbove ?? 0,
+    linesBelow: overrides?.linesBelow ?? 0,
+    oldPath: overrides?.oldPath ?? filePath,
+    newPath: overrides?.newPath ?? filePath,
+  }),
+});
+
+/**
+ * エラーを返すモックリゾルバ
