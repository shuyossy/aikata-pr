+   */
+  async getSuggestDiscussions(projectId: string, mrIid: string): Promise<SuggestDiscussion[]> {
+    const discussions = await this.client.getAll<GitLabDiscussion>(
+      `/projects/${projectId}/merge_requests/${mrIid}/discussions`,
+    );
