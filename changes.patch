+  const clone = vi.fn<CloneManagerPort['clone']>().mockResolvedValue({
+    projectDir: '/tmp/test-clone',
+    sourceBranch: 'feature-branch',
+    targetBranch: 'main',
+    cleanup: cleanupFn,
+  });
+  return { clone, cleanupFn };
