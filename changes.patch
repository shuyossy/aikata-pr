+              `Each image is displayed in the order listed below. ` +
+              `Please continue your review using these images.\n\n` +
+              fileList,
+          },
+          ...pendingImages.map((img) => ({
+            type: 'file' as const,
+            mimeType: img.mediaType,
+            data: img.base64Data,
+          })),
+        ],
+      },
+    };
+
+    return { messages: [...messages, imageUserMessage] };
+  };
