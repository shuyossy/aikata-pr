+      /duration must be non-negative or null/,
+    );
+  });
+
+  it('durationがnullの場合は許容される', () => {
+    const job = Job.of(baseParams({ duration: null }));
+    expect(job.duration).toBeNull();
+  });
+
+  it('artifactsSizeが負数の場合はエラーになる', () => {
