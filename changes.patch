diff --git a/.ci-template/pipelines/template-npx.yml b/.ci-template/pipelines/template-npx.yml
new file mode 100644
index 0000000..6ad73e6
--- /dev/null
+++ b/.ci-template/pipelines/template-npx.yml
@@ -0,0 +1,51 @@
+# .ci-template/pipelines/template-npx.yml
+# 提供先プロジェクトで include して利用するCIテンプレート（npx方式）
+#
+# 使い方:
+#   include:
+#     - project: '<本プロジェクトのパス>'
+#       file: '.ci-template/pipelines/template-npx.yml'
+
+include:
+  - local: '.ci-template/variable/variables.yml'
+
+stages:
+  - review
+
+ai-review:
+  stage: review
+  image: node:22-slim
+  variables:
+    NPM_CONFIG_CACHE: "$CI_PROJECT_DIR/.npm"
+  cache:
+    key: "aikata-pr-v${AIKATA_VERSION}"
+    paths:
+      - .npm/
+  rules:
+    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
+  script:
+    # AIKATA_PR_DISABLED=trueの場合、AIレビューをスキップ
+    - |
+      if [ "$AIKATA_PR_DISABLED" = "true" ]; then
+        echo "AIKATA_PR_DISABLED is set to true. Skipping AI review."
+        exit 0
+      fi
+    # GITLAB_TOKENが設定されているかチェック
+    - |
+      if [ -z "$GITLAB_TOKEN" ]; then
+        echo "Error: GITLAB_TOKEN is not set. Please configure GITLAB_TOKEN." >&2
+        exit 1
+      fi
+    # GitLab npm Registryの認証設定
+    - echo "@aikata:registry=https://${CI_SERVER_HOST}/api/v4/projects/${AIKATA_PROJECT_ID}/packages/npm/" > .npmrc
+    - echo "//${CI_SERVER_HOST}/api/v4/projects/${AIKATA_PROJECT_ID}/packages/npm/:_authToken=${GITLAB_TOKEN}" >> .npmrc
+    # npx経由でaikata-prを実行（キャッシュによりバージョンが同じ場合は高速）
+    - |
+      npx @aikata/aikata-pr@${AIKATA_VERSION} \
+        --user-id "${USER_ID}" \
+        --project-id "${GITLAB_PROJECT_ID}" \
+        --mr-iid "${GITLAB_MR_IID}" \
+        --checklist "${CHECKLIST_PATH}" \
+        --review-settings "${REVIEW_SETTINGS_PATH}" \
+        --skills "${SKILLS_PATH}" \
+        --log-level "${AIKATA_LOG_LEVEL}"
