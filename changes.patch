+
+  it('全行異なる複数行の場合はnullを返す', () => {
+    const originalCode = ['OLD1', 'OLD2'].join('\n');
+    const suggestedCode = ['NEW1', 'NEW2'].join('\n');
+
+    const result = trimCommonLines(originalCode, suggestedCode);
+
+    expect(result).toBeNull();
+  });
+});
