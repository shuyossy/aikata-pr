{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Review (Local)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/cli.ts",
        "review",
        "--checklist", "${workspaceFolder}/debug/checklist.csv",
        "--review-settings", "${workspaceFolder}/debug/review-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Review (API)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/cli.ts",
        "review",
        "--checklist", "${workspaceFolder}/debug/checklist.csv",
        "--review-settings", "${workspaceFolder}/debug/review-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env.debug.api",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Pipeline Report (Local)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/cli.ts",
        "pipeline-report",
        "--pipeline-report-settings", "${workspaceFolder}/debug/pipeline-report-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env.debug.pipeline-report",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Pipeline Report (API)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/cli.ts",
        "pipeline-report",
        "--pipeline-report-settings", "${workspaceFolder}/debug/pipeline-report-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env.debug.pipeline-report.api",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug API Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": ["src/server.ts"],
      "envFile": "${workspaceFolder}/.env.debug.server",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack Review",
      "configurations": ["Debug API Server", "Debug Review (API)"],
      "stopAll": true
    },
    {
      "name": "Debug Full Stack Pipeline Report",
      "configurations": ["Debug API Server", "Debug Pipeline Report (API)"],
      "stopAll": true
    }
  ]
}
