{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI (Local)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/index.ts",
        "--checklist", "${workspaceFolder}/debug/checklist.csv",
        "--review-settings", "${workspaceFolder}/debug/review-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug CLI (API)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": [
        "src/index.ts",
        "--checklist", "${workspaceFolder}/debug/checklist.csv",
        "--review-settings", "${workspaceFolder}/debug/review-settings.json"
      ],
      "envFile": "${workspaceFolder}/.env.debug.api",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug API Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "args": ["src/server.ts"],
      "envFile": "${workspaceFolder}/.env.debug.server",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (Server + CLI)",
      "configurations": ["Debug API Server", "Debug CLI (API)"],
      "stopAll": true
    }
  ]
}
